ANTHROPIC_API_KEY=your_key_here
SPACETRACK_EMAIL=your_email_here
SPACETRACK_PASSWORD=your_password_here

# ---------------------------------------------------------------------------
# LLM provider selection (Phase 6).
# LLM_PROVIDER picks which backend the agent uses: anthropic | gemini | openai
# LLM_MODEL is the model id for that provider.
# Only the key for the selected provider is required; the others may stay blank.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
